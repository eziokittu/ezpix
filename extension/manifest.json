{
  "manifest_version": 3,
  "name": "EzPIX Insta",
  "version": "0.464.0",
  "minimum_chrome_version": "120",
  "description": "Draw, animate and capture pixel art in a local Chrome studio. Edit sprites and tilemaps, then download your work. No account.",
  "permissions": [
    "activeTab",
    "scripting",
    "alarms"
  ],
  "action": {
    "default_title": "Open EzPIX Insta",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/ezpix-insta-16.png",
      "32": "icons/ezpix-insta-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "icons": {
    "16": "icons/ezpix-insta-16.png",
    "32": "icons/ezpix-insta-32.png",
    "48": "icons/ezpix-insta-48.png",
    "128": "icons/ezpix-insta-128.png"
  }
}
