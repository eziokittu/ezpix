{
  "manifest_version": 3,
  "name": "EzPix SnapForge",
  "version": "0.461.0",
  "minimum_chrome_version": "120",
  "description": "Capture, cut out and style pixel assets. Download images and animations directly, entirely on your device.",
  "permissions": [
    "activeTab",
    "scripting",
    "alarms"
  ],
  "action": {
    "default_title": "Capture with SnapForge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/snapforge-16.png",
      "32": "icons/snapforge-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "https://glitchbong.com/*"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "icons": {
    "16": "icons/snapforge-16.png",
    "32": "icons/snapforge-32.png",
    "48": "icons/snapforge-48.png",
    "128": "icons/snapforge-128.png"
  }
}
