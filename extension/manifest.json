{
  "manifest_version": 3,
  "name": "EzPIX Insta",
  "version": "0.466.2",
  "minimum_chrome_version": "127",
  "description": "Capture and convert images in a toolbar pixel studio. Compare source and preview, tune settings and download or open the web editor.",
  "permissions": [
    "activeTab",
    "scripting",
    "alarms"
  ],
  "action": {
    "default_popup": "app.html",
    "default_title": "Open EzPIX Insta",
    "default_icon": {
      "16": "icons/ezpix-insta-16.png",
      "32": "icons/ezpix-insta-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "icons": {
    "16": "icons/ezpix-insta-16.png",
    "32": "icons/ezpix-insta-32.png",
    "48": "icons/ezpix-insta-48.png",
    "128": "icons/ezpix-insta-128.png"
  },
  "externally_connectable": {
    "matches": [
      "https://glitchbong.com/*"
    ]
  }
}
